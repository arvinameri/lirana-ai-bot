# ==========================================
# Bale Bot Settings
# ==========================================
BALE_BOT_TOKEN="your_bale_bot_token_here"
ADMIN_IDS="123456789,987654321"
ADMIN_BALE_ID="123456789"

# ==========================================
# Database (PostgreSQL)
# ==========================================
POSTGRES_USER="postgres_user"
POSTGRES_PASSWORD="postgres_password"
POSTGRES_SERVER="localhost"
POSTGRES_PORT="5432"
POSTGRES_DB="your_database_name"
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/dbname"

# ==========================================
# Cache (Redis)
# ==========================================
REDIS_HOST="localhost"
REDIS_PORT="6379"

# ==========================================
# AI Settings (OpenAI)
# ==========================================
OPENAI_API_KEY="sk-your-openai-api-key"

# ==========================================
# Bahoosh Sync API (Phase 2)
# ==========================================
BAHOOSH_API_KEY="your_bahoosh_api_key"
BAHOOSH_STORE_URL="https://api.bahoosh.com/v1/store"

# ==========================================
# Security & Backup
# ==========================================
BACKUP_ENCRYPTION_KEY="your_secure_encryption_key_here"